// =====================================================================
//  ゲート信号生成スクリプト（オープンループ／制御なし）
//    ① ブリッジレスPFC （Q1, Q2 ： ロウサイドスイッチ×2）
//    ② 位相シフトフルブリッジ （Q3,Q4＝レグA / Q5,Q6＝レグB、
//                               ハイサイド＝Q3, Q6）
//
//  【回路側の事前設定（インスペクタ）】
//   ・Q1〜Q6は PWM Switch 素子を使用。
//     Transitions Mode = Ratio（比率モード）、Transition数 = 2（T0,T1）。
//   ・Q1, Q2 は Ratio 1点のみ使用するため、T1 は 1（＝周期末）のまま固定でも可。
//       Q1, Q2 : Initial State = ON   （T0 で OFF に切り替わる）
//   ・Q3, Q6（ハイサイド）: Initial State = OFF （T0でON、T1でOFF）
//   ・Q4, Q5（ローサイド）: Initial State = ON  （T0でOFF、T1でON）
//   ・本スクリプトはフルブリッジのスイッチング周波数 Fs_fb と同じ周波数で
//     スキャンされるよう、シミュレーション設定側の「スクリプト実行周波数
//     （サブ周波数）」を Fs_fb に合わせてください。
//   ・AC入力の極性判定用に、電圧プローブ VL_sense / VN_sense を用意してください
//     （名称が異なる場合は下の output() の引数を実際のシンボル名に変更）。
//
//  参考：Scideam HELP CENTER
//   - スクリプト言語文法 / 機能関数の使用方法
//   - PWM Switch（Transitions, Ron/Roff, Initial State）
//   - 位相シフトフルブリッジ回路サンプル（位相シフトの考え方）
// =====================================================================

// ---------------- パラメータ設定（ここを編集） ----------------
D_pfc    = 0.5;        // PFC(Q1,Q2) オープンループ固定デューティ比 [0〜1]
                        // ※ 入力電圧に応じた簡易フィードフォワードにしたい場合は
                        //    例）D_pfc = 1 - abs(Vac)/Vpeak;  のように置き換え可

Fs_fb    = 100e3;      // フルブリッジ(Q3-Q6) スイッチング周波数 [Hz]
Ts_fb    = 1/Fs_fb;
PhaseDeg = 90;         // フルブリッジ 位相シフト角 [deg]（0〜180、固定値）
Tdead    = 200e-9;     // フルブリッジ デッドタイム [s]

// ---------------- ① 半周期判定（両ステージ共通） ----------------
Vac = output("VL_sense","V","inst") - output("VN_sense","V","inst");
// センス点が用意できない場合は下記のように内部基準正弦波で代用可：
// Vac = sin(2*PI*50*t);

if (Vac >= 0) {
    Half = 1;   // 正の半周期
} else {
    Half = 0;   // 負の半周期
}
setoutvar(Half);
setoutvar(Vac);

// =====================================================================
// ② ブリッジレスPFC ゲート信号（Q1, Q2）
//    正の半周期：Q1が高周波PWM、Q2は常時OFF
//    負の半周期：Q2が高周波PWM、Q1は常時OFF
// =====================================================================
if (Half == 1) {
    setparam("Q1","T0", D_pfc);   // Q1：Ratio T0までON→以降OFF
    setparam("Q2","T0", 0);       // Q2：常時OFF（ゲートブロック）
} else {
    setparam("Q2","T0", D_pfc);
    setparam("Q1","T0", 0);
}

// =====================================================================
// ③ 位相シフトフルブリッジ ゲート信号（Q3,Q4 / Q5,Q6）
//    レグA = Q3(ハイサイド) / Q4(ローサイド)
//    レグB = Q6(ハイサイド) / Q5(ローサイド)
//
//    正の半周期：レグAが基準（移相0）、レグBが遅れ位相
//    負の半周期：レグBが基準（移相0）、レグAが遅れ位相
// =====================================================================
d          = Tdead / Ts_fb;      // デッドタイム→比率換算
ShiftRatio = PhaseDeg / 360;     // 位相シフト角→比率換算（0〜0.5）

if (Half == 1) {
    ShiftA = 0;
    ShiftB = ShiftRatio;
} else {
    ShiftA = ShiftRatio;
    ShiftB = 0;
}

// ---- レグA : Q3(ハイサイド) / Q4(ローサイド) ----
edge1 = ShiftA;
edge2 = ShiftA + 0.5;

Q3_T0 = edge1 + d;    // ON
Q3_T1 = edge2 - d;    // OFF
setparam("Q3","T0", Q3_T0);
setparam("Q3","T1", Q3_T1);

Q4_T0 = edge1 - d;    // OFF（Q3のONより先にOFFさせる＝デッドタイム）
if (Q4_T0 < 0) { Q4_T0 = 0; }
Q4_T1 = edge2 + d;    // ON
if (Q4_T1 > 1) { Q4_T1 = 1; }
setparam("Q4","T0", Q4_T0);
setparam("Q4","T1", Q4_T1);

// ---- レグB : Q6(ハイサイド) / Q5(ローサイド) ----
edge1 = ShiftB;
edge2 = ShiftB + 0.5;

Q6_T0 = edge1 + d;
Q6_T1 = edge2 - d;
setparam("Q6","T0", Q6_T0);
setparam("Q6","T1", Q6_T1);

Q5_T0 = edge1 - d;
if (Q5_T0 < 0) { Q5_T0 = 0; }
Q5_T1 = edge2 + d;
if (Q5_T1 > 1) { Q5_T1 = 1; }
setparam("Q5","T0", Q5_T0);
setparam("Q5","T1", Q5_T1);
