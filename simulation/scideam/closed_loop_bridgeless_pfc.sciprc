// =====================================================================
//  ブリッジレス昇圧PFC 閉ループ制御（平均電流制御 / ACMC）
//  対象回路： bridgeless PFC.scicir
//    AC100Vrms(50Hz) -> DC400V, 定電流負荷 IDC = 1.25A (500W)
//
//  【回路構成（bridgeless PFC.scicir から復元したネットリスト）】
//     VAC(+) ─ L(350uH) ─ IVS/iL(電流センス) ─┬─ D1 ─┐
//                                              └─ Q1 ─┤
//     VAC(-) ────────────────────────────────┬─ D2 ─┤(DC+)
//                                             └─ Q2 ─┤
//     DC+ ─ C(1.2mF) ─ GND,  IDC(1.25A) が DC+ から GND へ
//     Q1, Q2 はどちらも GND へのローサイドスイッチ（デュアルブースト構成）
//
//     正の半周期： Q1 が高周波PWM、帰路は Q2 のボディダイオード
//     負の半周期： Q2 が高周波PWM、帰路は Q1 のボディダイオード
//
//  【制御構成（二重ループ）】
//    外側：直流バス電圧ループ  ->  入力電流の振幅指令 Ipk_ref
//    内側：平均電流ループ      ->  デューティ補正 D_pi
//    ＋   完全フィードフォワード D_ff（正弦波整形はこちらが担当）
//
//  【サンプリング（ユーザ指定）】
//    電流ループ  F_ILOOP = 50 Hz     （N_I = 2000 スキャンに1回）
//    電圧ループ  F_VLOOP = 100 kHz   （毎スキャン。ただし帯域は 8 Hz に設計）
//    ※サンプリング周波数とループ帯域は別物。電圧ループは 100kHz で回しても
//      帯域 8Hz ＋ 30Hz LPF 2段で 100Hz リプルを除去するので PFC として成立する。
//    ※電流ループ 50Hz では商用1周期に1回しかデューティを更新できないため、
//      瞬時波形整形は D_ff が担当し、PI は1商用周期の平均電流誤差
//      （＝電流振幅の誤差）を補正する役割になる。
//
//  ゲインは pfc_acmc_sim.py（同フォルダ）が算出した値をそのまま転記している。
//  回路定数を変えたら pfc_acmc_sim.py を回し直して下記 KP/KI を更新すること。
//    py -3 pfc_acmc_sim.py
//  転記ミスの確認は verify_sciprc_port.py で行える。
//
//  【Scideam 側の設定】
//   ・スクリプトの実行周波数 = MainFrequency = 100 kHz
//     （下の FS と必ず一致させること。ここがずれると全ゲインがずれる）
//   ・Q1, Q2 は PwmSwitch、Mode = Ratio、InitialState = On、Transitions = 1点(T0)
//     → T0 に入れる値がそのまま昇圧デューティ（ON時間比）になる。
//   ・プローブ： VL / VN（AC入力、対GND）、ILsence（IVS出力の電圧プローブ）、
//               Vosence（VS 絶縁アンプ出力の電圧プローブ）
//   ・output() のモードは "AVE"（メイン周期の平均値）。理由は②参照。
//   ・シミュレーション時間は 0.6 秒以上にすること。
//     C = 1.2mF を 0V から 400V まで充電するのに約 0.4 秒かかるため、
//     既定の 0.12 秒では整定前で終わってしまう。
//     C の InitialVoltage を 400 に設定すれば 0.2 秒程度で確認できる。
// =====================================================================

// ---------------------------------------------------------------------
// ① 定数（回路定数を変えたらここと下の KP/KI を更新）
// ---------------------------------------------------------------------
FS        = 100e3;        // スクリプト実行周波数 [Hz]  ★MainFrequency と一致させる
TS        = 1/FS;

F_LINE    = 50;           // VAC.Frequency [Hz]
W_LINE    =PI2*F_LINE;    // = 2*PI*F_LINE [rad/s]
VAC_PK    = 100*sqrt(2);    // = VAC.Voltage(100Vrms) * sqrt(2) [V]
VBUS_REF  = 400;          // 直流バス電圧指令 [V]

L_PFC     = 350e-6;       // L.Inductance [H]
                          //  ★ここの精度が電流波形の質を決める（F_ILOOP=50Hz のため
                          //    波形整形はフィードフォワード頼み）。
                          //    設定値が実際より「大きい」ずれが致命的。
                          //    動作電流での実測値、またはそれより小さめの値を入れる。

// 導通経路の等価定数（bridgeless PFC.scicir の素子パラメータから算出）
//   充電時 : VAC → L(Esr 10m) → Q(Ron 100m) → GND → 反対側ボディダイオード
//                                                    (Vonb 1V, Ronb 100m) → VAC
//   放出時 : VAC → L(Esr 10m) → D(Vf 700m, Ron 100m) → Vbus → GND → 同上 → VAC
//   Q と D のオン抵抗が等しいのでデューティに依らず R_EQ は一定になる。
R_EQ      = 0.21;         // = L.Esr(10m) + Ronb(100m) + Ron(100m)
V_RET     = 1.0;          // 帰路ボディダイオードの順方向電圧 Vonb [V]
                          //  ※SYNC_RETURN=1（同期整流）にするなら 0 にする
VF_D      = 0.7;          // 昇圧ダイオード D1/D2 の TurnOnVoltage [V]

N_I       = 2000;         // 電流ループ分周比 = FS / F_ILOOP = 100e3/50
N_V       = 1;            // 電圧ループ分周比 = FS / F_VLOOP = 100e3/100e3

// ---- センサ換算係数 ----
//   ILsence は IVS(IVConverter, Gain=1) 出力の電圧プローブ → 1V = 1A
//   Vosence は VS(IsolationAmplifier, Gain=1) 出力の電圧プローブ → 1V = 1V
//   VL / VN は対GNDの電圧プローブ（Gain=1）
K_VAC     = 1.0;          // (VL - VN) -> [V]
K_ISENSE  = 1.0;          // ILsence   -> [A]   ★電流の向きが逆なら -1.0
K_VBUS    = 1.0;          // Vosence   -> [V]

// ---- 制限値 ----
D_MAX     = 0.9;        // 最大デューティ
D_MIN     = 0.0;
IPK_MAX   = 10.6;         // 電流振幅指令の上限 [A]（定格7.07Aの1.5倍）
DPI_MAX   = 0.30;         // 電流PI出力（デューティ補正）の上限

// ---- PIゲイン（pfc_acmc_sim.py の出力を転記）----
//  電流ループ： FC_I = 2.500 Hz, 零点 7.822 Hz
//              開ループ fc = 2.50 Hz, 位相余裕 79.2 deg, ゲイン余裕 9.1 dB
//   ※このループのプラント |Gid| = (Vbus+Vf)/|R_EQ + jwL| は fc 付近で抵抗性
//     （L/R 折点 = 95 Hz）のため、単純に「fc で 0dB」設計にすると開ループゲインが
//     広い帯域で 1 に張り付き、無駄時間(1.5*Ts=30ms)が -180deg を作る 13Hz 付近で
//     ゲイン余裕がゼロになる。KP_I はゲイン余裕 10dB 側で決めている。
KP_I      = 1.596016e-04;
KI_I_TS   = 1.568842e-04; // = KI_I * (1/F_ILOOP)  … 1回の実行で積む量

//  電圧ループ： FC_V = 8.000 Hz, 零点 2.000 Hz
//              開ループ fc = 7.75 Hz, 位相余裕 46.6 deg, ゲイン余裕 16.3 dB
KP_V      = 3.412134e-01;
KI_V_TS   = 4.287814e-05; // = KI_V * (1/F_VLOOP)

// ---- フィルタ係数 ----
A_VBUS    = 1.884956e-03; // バス電圧LPF 1次×2段  = 2*PI*30Hz/FS
A_DVDT    = 0.1256637;    // |vac| の増減判定用LPF = 2*PI*2kHz/FS
A_VPK     = 1.0e-4;       // 入力ピーク推定の減衰（時定数約100ms）

// ---- ソフトスタート ----
VREF_SLEW = 2600;         // バス電圧指令のランプ速度 [V/s]

// ---- 動作モード ----
SHAPE_PI  = 1;            // 1: 電流PI出力を正弦テンプレートで整形（F_ILOOP<1kHz 用）
                          // 0: 素の瞬時ACMC（F_ILOOP を 2kHz 以上にする場合）
SYNC_RETURN = 0;          // 1: 帰路スイッチを常時ONで駆動（同期整流、約5W改善）
                          //    その場合 V_RET を 0 にすること

PO_HYST   = 0.70711;      // 極性判定ヒステリシス = 0.005 * VAC_PK [V]

// ---------------------------------------------------------------------
// ② センシング
//    output() の第3引数はモード指定。"AVE" = メイン周期の代表点として平均値、
//    "FIN" = 最終値。ここは必ず "AVE" を使う。
//    理由：平均電流制御が必要とするのは「スイッチング1周期の平均インダクタ電流」。
//    瞬時値を読むとリプルの谷を読むことになり、真の平均より低い値になる。
//    この誤差はデューティに比例して商用周期内で変動するのでそのまま歪みになる。
// ---------------------------------------------------------------------
Vbus_raw = K_VBUS * output("Vosence","V","AVE");
Vac = K_VAC * ( output("VL","V","AVE") - output("VN","V","AVE") );
IL  = K_ISENSE * output("ILsence","V","AVE");
Vr  = abs(Vac);                   // 整流入力電圧 |vac|

// ---------------------------------------------------------------------
// ③ 初回スキャンのみの初期化
//    （変数は自動で 0 初期化されるので Init==0 が初回の判定になる）
// ---------------------------------------------------------------------
if (Init == 0) {
    Vbus_f1 = Vbus_raw;       // LPF 1段目の初期値
    Vbus_f2 = Vbus_raw;       // LPF 2段目の初期値
    Vpk_est = VAC_PK;         // 入力ピーク推定の初期値
    Vref    = Vbus_raw;       // ソフトスタート：実測値から立ち上げる
    Vr_prev = Vr;
    Iv      = 0;              // 電圧PI 積分器
    Ii      = 0;              // 電流PI 積分器
    Init    = 1;
}

// 極性判定（ヒステリシス付き。ゼロクロス近傍のチャタリング防止）
// Half は自動0初期化なので、最初の正の半周期で 1 に切り替わる
if (Half == 1) {
    if (Vac < -PO_HYST) { Half = 0; }
} else {
    if (Vac >  PO_HYST) { Half = 1; }
}

// 整流座標のインダクタ電流（正の半周期はそのまま、負の半周期は符号反転）
if (Half == 1) { Ir =  IL; } else { Ir = -IL; }

// ---------------------------------------------------------------------
// ④ 入力ピーク推定（電流指令テンプレートの正規化に使う）
// ---------------------------------------------------------------------
if (Vr > Vpk_est) {
    Vpk_est = Vr;
} else {
    Vpk_est = Vpk_est - Vpk_est * A_VPK;
}
if (Vpk_est < 0.2 * VAC_PK) { Vpk_est = 0.2 * VAC_PK; }

// ---------------------------------------------------------------------
// ⑤ バス電圧の平均化（1次LPF × 2段）
//    100Hz リプルをここで落とさないと電流指令が歪む（電圧ループを 100kHz で
//    回す場合に必須）。30Hz×2段で 100Hz を約 -21dB。
// ---------------------------------------------------------------------
Vbus_f1 = Vbus_f1 + (Vbus_raw - Vbus_f1) * A_VBUS;
Vbus_f2 = Vbus_f2 + (Vbus_f1  - Vbus_f2) * A_VBUS;

// ---------------------------------------------------------------------
// ⑥ ソフトスタート（バス電圧指令のランプ）
// ---------------------------------------------------------------------
if (Vref < VBUS_REF) {
    Vref = Vref + VREF_SLEW * TS;
    if (Vref > VBUS_REF) { Vref = VBUS_REF; }
}

// ---------------------------------------------------------------------
// ⑦ 電圧ループ（N_V スキャンごと ＝ 100kHz）
//    出力：入力電流の振幅指令 Ipk_ref [A]
// ---------------------------------------------------------------------
if (mod(ScanCnt, N_V) == 0) {
    Ev = Vref - Vbus_f2;

    Iv = Iv + KI_V_TS * Ev;                 // 積分
    // アンチワインドアップ（出力が 0〜IPK_MAX に収まる範囲へ積分器をクランプ）
    Iv_lo = 0       - KP_V * Ev;
    Iv_hi = IPK_MAX - KP_V * Ev;
    if (Iv > Iv_hi) { Iv = Iv_hi; }
    if (Iv < Iv_lo) { Iv = Iv_lo; }

    Ipk_ref = KP_V * Ev + Iv;
    if (Ipk_ref > IPK_MAX) { Ipk_ref = IPK_MAX; }
    if (Ipk_ref < 0)       { Ipk_ref = 0; }
}

// ---------------------------------------------------------------------
// ⑧ 電流指令とその微分（フィードフォワード用）
//    i_ref = Ipk*|sin| なので di_ref/dt = Ipk*W_LINE*|cos|。
//    |cos| = sqrt(1 - Templ^2) と解析式で求める。
//    ※差分＋LPF で微分の「大きさ」を作ると、そのフィルタ遅れがそのまま
//      電流誤差になり、ゼロクロスで電流が先に 0 に張り付いて歪む
//      （実測：THD 3.1% -> 5.1% に悪化）。差分は増減の符号判定にだけ使う。
// ---------------------------------------------------------------------
Templ = Vr / Vpk_est;
if (Templ > 1) { Templ = 1; }
Iref  = Ipk_ref * Templ;

Dvr   = (Vr - Vr_prev) * FS;
Vr_prev = Vr;
Dvr_f = Dvr_f + (Dvr - Dvr_f) * A_DVDT;     // 増減の符号判定用
if (Dvr_f >= 0) { Sgn = 1; } else { Sgn = -1; }
Cos_t = sqrt(1 - Templ * Templ);
Didt  = Ipk_ref * W_LINE * Cos_t * Sgn;     // di_ref/dt [A/s]

// ---------------------------------------------------------------------
// ⑨ 電流ループ（毎スキャン誤差を積算し、N_I スキャンごとに平均して PI 更新）
//    ＝これが「平均電流制御」。F_ILOOP=50Hz では商用1周期の平均誤差になる。
// ---------------------------------------------------------------------
ErrSum = ErrSum + (Iref - Ir);
ErrCnt = ErrCnt + 1;

if (mod(ScanCnt, N_I) == 0) {
    if (ErrCnt > 0) {
        Ei = ErrSum / ErrCnt;               // 平均電流誤差 [A]

        Ii = Ii + KI_I_TS * Ei;             // 積分
        Ii_lo = -DPI_MAX - KP_I * Ei;       // アンチワインドアップ
        Ii_hi =  DPI_MAX - KP_I * Ei;
        if (Ii > Ii_hi) { Ii = Ii_hi; }
        if (Ii < Ii_lo) { Ii = Ii_lo; }

        D_pi = KP_I * Ei + Ii;
        if (D_pi >  DPI_MAX) { D_pi =  DPI_MAX; }
        if (D_pi < -DPI_MAX) { D_pi = -DPI_MAX; }

        ErrSum = 0;
        ErrCnt = 0;
    }
}

// ---------------------------------------------------------------------
// ⑩ 完全フィードフォワード
//    (1-d)*(Vbus + VF_D) = |vac| - V_RET - R_EQ*i_ref - L*di_ref/dt
//    を満たす d を直接計算する。
//    ※ d = 1 - |vac|/Vbus だけでは「電流ゼロの平衡点」になり電流が流れない。
//      R_EQ 項と L*di/dt 項が正弦波電流を作っている本体。
//    ※ 素子の導通降下（V_RET, VF_D, 各オン抵抗）を入れないと指令どおりの
//      電流にならない。V_RET = 1V は |vac| がそれ以下の区間で電流を流せない
//      ことも意味する（クロスオーバ歪みの下限）。
// ---------------------------------------------------------------------
Vb = Vbus_raw;
if (Vb < 1) { Vb = 1; }
D_ff = 1 - (Vr - V_RET - R_EQ * Iref - L_PFC * Didt) / (Vb + VF_D);

// ---------------------------------------------------------------------
// ⑪ デューティ合成と制限
// ---------------------------------------------------------------------
if (SHAPE_PI == 1) {
    D_pfc = D_ff + D_pi * Templ;
} else {
    D_pfc = D_ff + D_pi;
}
if (D_pfc > D_MAX) { D_pfc = D_MAX; }
if (D_pfc < D_MIN) { D_pfc = D_MIN; }

// ---------------------------------------------------------------------
// ⑫ ゲート配分
//    正の半周期： Q1 が高周波PWM、Q2 は帰路（ボディダイオード)
//    負の半周期： その逆
// ---------------------------------------------------------------------
if (Half == 1) {
    setparam("Q1","T0", D_pfc);
    setparam("Q2","T0", 0);
} else {
    setparam("Q2","T0", D_pfc);
    setparam("Q1","T0", 0);
}

// ---------------------------------------------------------------------
// ⑬ スキャンカウンタ更新と波形出力
// ---------------------------------------------------------------------
ScanCnt = ScanCnt + 1;
if (ScanCnt >= N_I) { ScanCnt = 0; }   // N_I の倍数で 1 周する（N_V=1 なので支障なし）

setoutvar(Iref);        // 電流指令（整流座標）
setoutvar(Ir);          // インダクタ電流（整流座標）
setoutvar(Ipk_ref);     // 電流振幅指令
setoutvar(Vbus_f2);     // 電圧ループ入力（平均化後のバス電圧）
setoutvar(Vref);        // バス電圧指令（ソフトスタート中はランプする）
setoutvar(D_pfc);       // PFCデューティ
setoutvar(D_pi);        // 電流PI の補正量
setoutvar(Half);        // 極性

// =====================================================================
//  【動作確認の手順】
//   0. シミュレーション時間を 0.6 秒以上に（C=1.2mF の充電に約0.4秒かかる）。
//      C の InitialVoltage を 400 にすれば 0.2 秒程度で済む。
//   1. スクリプト実行周波数が 100kHz（= MainFrequency）か確認
//   2. まず Vbus_f2 が VBUS_REF=400V に整定するか見る
//      → 発散するなら KP_V, KI_V_TS を 1/2 ずつ下げる
//   3. 次に Iref と Ir を重ねて見る
//      → 追従していなければ K_ISENSE（符号を含む）と Half（極性）を疑う
//      → Ir にスイッチングリプルが残っているなら output() のモードを確認
//   4. D_pi はごく小さい値（±0.01 程度）で動くのが正常。
//      張り付いている場合は L_PFC / R_EQ の設定値と実回路がずれている。
//
//  【期待値（pfc_acmc_sim.py による）】
//    Vbus 400.0 V、リプル 3.4 Vpp、入力電流 5.12 Arms、
//    力率 0.998、THD 3.1 %、入力電力 511 W（出力 500 W）
// =====================================================================
